# OpenAI OCR (Naver CLOVA 대체)
OPENAI_API_KEY=sk-...
OCR_MODEL=gpt-4o

# MongoDB Atlas (original_db)
MONGODB_URI=mongodb+srv://loum_java:...@loum.veydouo.mongodb.net/original_db?retryWrites=true&w=majority&appName=loum

# Prefect 설정 (로컬 배포용)
PREFECT_HOME=${PWD}/.prefect
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_API_ENABLE_METRICS=true

# 스크래핑 설정
SCRAPING_OUTPUT_DIR=data/output
SCRAPING_SCHEDULE_CRON=0 0 * * 1  # 매주 월요일 자정 (UTC)

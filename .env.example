# roeum-crawler 환경 변수 예시. 실제 값은 .env(git 추적 안 함)에 둔다.
# 비밀값(접속 주소·키·웹훅)을 이 파일이나 코드에 적지 않는다.

# MongoDB (운영 original_db). MONGODB_URI 가 우선, 없으면 MONGO_URI.
MONGODB_URI=
MONGO_DB_NAME=original_db
MONGO_SOCKET_TIMEOUT_MS=60000
# local 이면 Atlas 주소를 거부한다(로컬 개발 보호)
CRAWLER_ENV=

# PDF 본문 추출 서비스(chat_generation /api/extract-text)
# 맥미니: staging 컨테이너 127.0.0.1:8000 / ECS: 운영 내부 주소 http://chat-generation.local:8000
CHAT_GENERATION_URL=http://127.0.0.1:8000
# 추출 호출 간격(초)·추출 서버가 응답하지 않은 뒤 쉬는 시간(초). 비우면 2·600
EXTRACT_INTERVAL_SECONDS=
EXTRACT_PAUSE_SECONDS=

# 국가법령 Open API 식별자(비밀 아님, 비우면 코드 기본값)
LAWGO_OC=

# 일일 실행 요약 알림(run_daily.sh). 데이터 수집 채널 값이 있으면 그쪽, 없으면 DISCORD_WEBHOOK
DISCORD_WEBHOOK=
DISCORD_WEBHOOK_DATA_COLLECT=
CRAWLER_DISCORD_SUMMARY=1

# 수집 결과를 JSONL 로도 남길지
SAVE_JSONL=true

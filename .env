PG_DSN=postgresql://roeum:roeum@127.0.0.1:5432/roeum
DB_DSN=postgresql://roeum:roeum@127.0.0.1:5432/roeum
EMBED_BACKEND=local          # 또는 openai / stub
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
# EMBED_DIM=768              # 필요하면 명시

# MongoDB 설정
MONGO_URI=mongodb://roeum:password@localhost:27017/roeum_crawler?authSource=admin
MONGO_DB_NAME=roeum_crawler

# Prefect 설정 (로컬 배포용)
PREFECT_HOME=${PWD}/.prefect
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_API_ENABLE_METRICS=true

# 스크래핑 설정
SCRAPING_OUTPUT_DIR=data/output
SCRAPING_SCHEDULE_CRON=0 0 * * 1  # 매주 월요일 자정 (UTC)

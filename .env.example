# roeum-crawler 환경 변수 예시. 실제 값은 .env(git 추적 안 함)에 둔다.
# 비밀값(접속 주소·키·웹훅)을 이 파일이나 코드에 적지 않는다.

# MongoDB (운영 original_db). MONGODB_URI 가 우선, 없으면 MONGO_URI.
MONGODB_URI=
MONGO_DB_NAME=original_db
MONGO_SOCKET_TIMEOUT_MS=60000
# local 이면 Atlas 주소를 거부한다(로컬 개발 보호)
CRAWLER_ENV=

# PDF 본문 추출 서비스(chat_generation /api/extract-text)
# 맥미니: staging 컨테이너 127.0.0.1:8000 / ECS: 운영 내부 주소 http://chat-generation.local:8000
CHAT_GENERATION_URL=http://127.0.0.1:8000
# 추출 호출 간격(초)·서버가 멈춘 뒤 되살아나기를 기다리는 최대 시간(초)·한 실행에서 허용하는 서버 멈춤 횟수. 비우면 2·600·2
EXTRACT_INTERVAL_SECONDS=
EXTRACT_RECOVERY_WAIT_SECONDS=
EXTRACT_MAX_SERVER_FAILURES=
# 서버가 멈춘 동안 상태를 확인하는 간격(초, 기본 15). 쓸 때만 주석을 푼다
# EXTRACT_HEALTH_POLL_SECONDS=

# 국가법령 Open API 식별자(비밀 아님, 비우면 코드 기본값)
LAWGO_OC=

# 일일 실행 요약 알림(run_daily.sh). 데이터 수집 채널 값이 있으면 그쪽, 없으면 DISCORD_WEBHOOK
DISCORD_WEBHOOK=
DISCORD_WEBHOOK_DATA_COLLECT=
CRAWLER_DISCORD_SUMMARY=1
# 채널별 웹훅(비우면 DISCORD_WEBHOOK 으로 폴백). BATCH 는 실행 중복(락) 경고, SERVER_ERROR·DEPLOY 는 이 크롤러가 쓰지 않지만 알림 모듈이 읽는다
DISCORD_WEBHOOK_BATCH=
DISCORD_WEBHOOK_SERVER_ERROR=
DISCORD_WEBHOOK_DEPLOY=
# 알림 제목에 붙는 환경 이름(비우면 prod)
ROEUM_ENV=

# 실행·로그 (run_daily.sh / docker/entrypoint.sh, ECS 는 Dockerfile·태스크 정의가 넣는다)
# 실행에 쓸 파이썬(기본 스크립트 안의 값), 저장소 위치(기본 스크립트가 있는 곳)
PYTHON=
CRAWLER_DIR=
# 1이면 실행 로그를 표준 출력에도 낸다(컨테이너 → CloudWatch Logs)
CRAWLER_LOG_STDOUT=
# 일일 요약에 적을 로그 위치 안내 문구(비우면 "로그 위치 미설정")
CRAWLER_LOG_LOCATION=
# 1이면 시도마다 최대 메모리·CPU 시간을 RESOURCE 한 줄로 남긴다
CRAWLER_RESOURCE_LOG=
# 중복 실행 방지 락 파일 경로(기본 /tmp/roeum_crawler.lock)
CRAWLER_LOCKFILE=
# 재시도 사이 대기(초, 기본 900). 숫자 값이라 쓸 때만 주석을 푼다
# RETRY_WAIT_SECONDS=
# 컨테이너 전체 실행 시간 제한(timeout 형식, 기본 170m)
CRAWLER_TIME_LIMIT=
# 스크래퍼를 하나씩 시작하는 간격(초, 기본 3)
# SCRAPER_START_INTERVAL_SECONDS=
# 로그 파일 이름에 붙는 실행 ID(비우면 시작 시각)
SCRAPER_RUN_ID=

# 배치 보고 (ops/batch_report.py, 키는 값이 있으면 BATCH_REPORT_KEY 가 우선)
BATCH_REPORT_JOB=
BATCH_REPORT_URL=
BATCH_REPORT_KEY=
BATCH_REPORT_KEY_FILE=
BATCH_REPORT_HOST=
BATCH_REPORT_SPOOL=

# 법률 DB 공개 페이지 재생성 요청(scripts/notify/repo_dispatch.py). 토큰은 ECS 에서 시크릿으로 주입
LEGALDB_DISPATCH_TOKEN=

# 수동 도구 pdf-ingest / pdf-reparse 가 PDF 를 찾는 상위 디렉터리(--pdf-dir 로도 줄 수 있다)
PDF_DB_DIR=

# 수집 결과를 JSONL 로도 남길지
SAVE_JSONL=true
